# Example Bor Configuration File
# Copy to ~/.config/bor.conf and customize.
# Unknown or misspelled sections and options are ignored; Bor shows a warning
# for each one when it starts.

[general]
# Maximum number of messages to display in message list
max_messages = 400

# Message list dates (strftime): older than this year / this year / today
date_format = "%Y-%m-%d %H:%M"
short_date_format = "%m/%d"
time_format = "%H:%M"

# Textual UI theme (e.g. textual-dark, textual-light, nord, gruvbox, dracula)
theme = "textual-dark"

[folders]
# Maildir folders (relative to mu root maildir)
inbox = "/INBOX"
archive = "/Archive"
drafts = "/Drafts"
sent = "/Sent"
trash = "/Trash"

[smtp]
# SMTP server settings
server = "smtp.example.com"
port = 587
username = "user@example.com"
# Password can be omitted if stored in the system keyring
# (service "bor-email", user = username); there is no interactive prompt.
# password = "your-password"
# use_starttls (port 587) takes precedence; use_tls alone means SMTPS (port 465)
use_tls = true
use_starttls = true

[identity]
# Default identity
name = "Your Name"
email = "user@example.com"
# Optional organization (currently unused)
organization = ""
# Signature (use triple quotes for multiline)
signature = """
--
Your Name
"""

[colors]
# Message list colors (Rich styles)
# Valid color names: blue, green, red, yellow, magenta, cyan, dark_orange, orange1, etc.
# You can also use hex colors like "#ff8c00"
unread = "blue"
# flagged messages
important = "dark_orange"
# header, quoted and marked are accepted but currently have no effect

[sync]
# External synchronization command. It is run directly, not through a shell,
# so use sh -c '...' for && or pipes. Bor runs `mu index` itself afterwards.
command = "mbsync -a"
# Alternative examples:
# command = "offlineimap"
# command = "sh -c 'mbsync work && mbsync personal'"

[threading]
# Enable threading by default
enabled = true
# Thread indicator character (currently unused; threads are drawn as a tree)
indicator = "↳"

[aliases]
# Tab autocompletions in compose mode
# Format: letter = "expanded text"
# Example: pressing 'r' then Tab expands to "Best regards,"
r = "Best regards,"
t = "Thank you for your email."
k = "Kind regards,"

[email_aliases]
# Email address aliases for quick addressing
# Works like .mailrc aliases (~/.mailrc aliases are merged in)
# Example:
# john = "john.doe@example.com"
# team = "alice@example.com, bob@example.com"

[display]
# Column widths; the layout is fixed (flags, date, from, subject) and the
# subject fills the remaining width
date_width = 12
from_width = 20
flags_width = 6

# Flags symbols
flag_unread = "●"
flag_replied = "↩"
flag_forwarded = "→"
flag_flagged = "⚑"
flag_attachment = "📎"
flag_marked = "𝐌"

[html]
# HTML-only emails are converted with html2text when installed.
# Directory for the temporary file used by "view in browser" (V)
# browser_tmp_dir = "~/tmp/bor"

[attachments]
# Default directory for saving attachments
save_directory = "~/Downloads"
# Preview images inline with the kitty graphics protocol (if available)
use_kitty_icat = true
# Force kitty graphics support even when TERM is not xterm-kitty
force_kitty_support = false

# [editor] external = "..." is accepted but not implemented yet.
